{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zinc-docs",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "zinc.carbonsoft.sh", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
