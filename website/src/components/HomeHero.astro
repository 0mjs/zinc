---
import { Code } from "astro:components";

const serverExample = `package main

import (
    "log"

    "github.com/0mjs/zinc"
)

func main() {
    app := zinc.New()

    app.Get("/", func(c *zinc.Context) error {
        return c.JSON(zinc.Map{"message": "Hello from Zinc!"})
    })

    log.Fatal(app.Listen(":8080"))
}`;

---

<section class="z-hero">
  <div class="z-hero-heading">
    <div>
      <span class="z-eyebrow"><i></i> Zinc 0.2.1 available now!</span>
      <h1>Fast Go APIs.<br /><span>Still net/http.</span></h1>
    </div>

    <div class="z-hero-intro">
      <p>
        Routing, binding, errors, and middleware on top of the HTTP stack you
        already know. Zinc stays small enough to get out of the way.
      </p>
      <div class="z-actions">
        <a class="z-button primary" href="/guide/quickstart/">Start building <b>→</b></a>
        <a class="z-button secondary" href="https://github.com/0mjs/zinc">GitHub</a>
      </div>
      <button class="z-install" type="button" data-copy="go get github.com/0mjs/zinc" aria-label="Copy the Zinc install command">
        <span>$</span> go get github.com/0mjs/zinc <b aria-hidden="true">copy</b>
      </button>
    </div>
  </div>

  <div class="z-bench" aria-label="Zinc example application and terminal response">
    <div class="z-window-bar">
      <div class="z-window-controls" aria-hidden="true"><i></i><i></i><i></i></div>
      <span>main.go</span>
      <img src="/go.png" alt="Go" />
    </div>

    <div class="z-bench-body">
      <div class="z-code-panel">
        <Code code={serverExample} lang="go" theme="tokyo-night" />
      </div>

      <div class="z-terminal-panel" data-terminal aria-label="Terminal running curl against the Zinc application and receiving a JSON response">
        <div class="z-terminal-screen">
          <div class="z-terminal-command"><span>$</span> <span data-terminal-command></span><i aria-hidden="true"></i></div>
          <div class="z-terminal-response" data-terminal-response>
            <p><strong>HTTP/1.1 200 OK</strong></p>
            <p><b>Content-Type:</b> application/json; charset=utf-8</p>
            <pre><span>{`{"message":"Hello from Zinc!"}`}</span></pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".z-install").forEach((button) => {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy || "");
        const mark = button.querySelector("b");
        if (mark) mark.textContent = "copied";
        window.setTimeout(() => {
          if (mark) mark.textContent = "copy";
        }, 1200);
      } catch {}
    });
  });

  document.querySelectorAll<HTMLElement>("[data-terminal]").forEach((terminal) => {
    if (terminal.dataset.running) return;
    terminal.dataset.running = "true";

    const command = terminal.querySelector<HTMLElement>("[data-terminal-command]");
    const response = terminal.querySelector<HTMLElement>("[data-terminal-response]");
    const value = "curl -i localhost:8080";
    const sleep = (ms: number) => new Promise((resolve) => window.setTimeout(resolve, ms));

    if (!command || !response) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      command.textContent = value;
      response.classList.add("visible");
      return;
    }

    const play = async () => {
      while (terminal.isConnected) {
        command.textContent = "";
        response.classList.remove("visible");
        await sleep(650);
        for (const character of value) {
          command.textContent += character;
          await sleep(58);
        }
        await sleep(400);
        response.classList.add("visible");
        await sleep(4200);
      }
    };

    play();
  });
</script>
